{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future equipment recognition draft; no automatic profile writes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "items"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"const": "pending-human-review"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["characterCode", "slot", "affixes", "evidence"],
        "properties": {
          "characterCode": {"type": ["string", "null"]},
          "slot": {"enum": ["head", "body", "arms", "legs", null]},
          "affixes": {
            "type": "array", "maxItems": 3,
            "items": {"type": "object", "additionalProperties": false,
              "required": ["name", "value", "tier"],
              "properties": {"name": {"type": ["string", "null"]}, "value": {"type": ["number", "null"]}, "tier": {"type": ["integer", "null"], "minimum": 1, "maximum": 15}}}
          },
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
            "required": ["captureId", "pipeline", "box"], "properties": {
              "captureId": {"type": "string"}, "pipeline": {"type": "string"},
              "box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
            }}}
        }
      }
    }
  }
}
